    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "setup-env": "@php bin/setup-env.php",
        "post-root-package-install": "@setup-env",
        "post-install-cmd": "@setup-env",
        "post-update-cmd": "@setup-env"
    },
